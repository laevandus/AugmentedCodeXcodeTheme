{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Augmented Code",
  "author": "Toomas",
  "themes": [
    {
      "name": "Augmented Code Dark",
      "appearance": "dark",
      "style": {
        "accents": ["#FCB057", "#97C3A1", "#83BCFF", "#B39EE6", "#68C5DB"],
        "background": "#1E3038",
        "border": "#405963",
        "border.focused": "#68C5DB",
        "border.selected": "#FCB057",
        "border.variant": "#304852",
        "conflict": "#FCB057",
        "created": "#97C3A1",
        "deleted": "#F17693",
        "editor.active_line.background": "#1D3039",
        "editor.active_line_number": "#F2F3E8",
        "editor.background": "#223842",
        "editor.foreground": "#F2F3E8",
        "editor.gutter.background": "#223842",
        "editor.indent_guide": "#294651",
        "editor.indent_guide_active": "#405963",
        "editor.invisible": "#2F4E5D",
        "editor.line_number": "#69828B",
        "editor.wrap_guide": "#294651",
        "element.active": "#405963",
        "element.background": "#29434D",
        "element.hover": "#304E59",
        "element.selected": "#405963",
        "error": "#F17693",
        "error.background": "#422F3D",
        "ghost_element.hover": "#29434D",
        "icon": "#D1D2CD",
        "icon.accent": "#68C5DB",
        "icon.muted": "#82959A",
        "info": "#83BCFF",
        "link_text.hover": "#68C5DB",
        "modified": "#FCB057",
        "pane.focused_border": "#68C5DB",
        "panel.background": "#1E3038",
        "panel.indent_guide": "#294651",
        "players": [{ "cursor": "#F4B73E", "selection": "#2F4E5D", "background": "#223842" }],
        "scrollbar.thumb.background": "#405963",
        "scrollbar.thumb.hover_background": "#53727D",
        "search.match_background": "#6E5428",
        "status_bar.background": "#1E3038",
        "success": "#97C3A1",
        "surface.background": "#29434D",
        "tab.active_background": "#223842",
        "tab.inactive_background": "#1E3038",
        "tab_bar.background": "#18303A",
        "terminal.background": "#223842",
        "terminal.foreground": "#F2F3E8",
        "terminal.bright_foreground": "#FFFFFF",
        "terminal.dim_foreground": "#C5C9C3",
        "terminal.ansi.black": "#18303A",
        "terminal.ansi.red": "#F17693",
        "terminal.ansi.green": "#97C3A1",
        "terminal.ansi.yellow": "#FCB057",
        "terminal.ansi.blue": "#83BCFF",
        "terminal.ansi.magenta": "#B39EE6",
        "terminal.ansi.cyan": "#68C5DB",
        "terminal.ansi.white": "#E6E8DF",
        "terminal.ansi.bright_black": "#53727D",
        "terminal.ansi.bright_red": "#FF8AA0",
        "terminal.ansi.bright_green": "#B1E7B8",
        "terminal.ansi.bright_yellow": "#FFD07B",
        "terminal.ansi.bright_blue": "#A7D6FF",
        "terminal.ansi.bright_magenta": "#D0BEFF",
        "terminal.ansi.bright_cyan": "#8ADCF0",
        "terminal.ansi.bright_white": "#FFFFFF",
        "text": "#F2F3E8",
        "text.accent": "#68C5DB",
        "text.disabled": "#69828B",
        "text.muted": "#A9B4B2",
        "warning": "#FCB057",
        "syntax": {
          "attribute": { "color": "#BF8555" },
          "boolean": { "color": "#B39EE6" },
          "comment": { "color": "#CFD2CD", "font_style": "italic" },
          "comment.doc": { "color": "#CFD2CD", "font_style": "italic" },
          "constant": { "color": "#97C3A1" },
          "constructor": { "color": "#97C3A1" },
          "embedded": { "color": "#F17693" },
          "emphasis": { "color": "#F2F3E8", "font_style": "italic" },
          "enum": { "color": "#B39EE6" },
          "function": { "color": "#97C3A1" },
          "hint": { "color": "#82959A" },
          "keyword": { "color": "#FCB057", "font_weight": 700 },
          "label": { "color": "#FCB057" },
          "link_text": { "color": "#68C5DB" },
          "number": { "color": "#B39EE6" },
          "operator": { "color": "#FCB057" },
          "predictive": { "color": "#82959A" },
          "property": { "color": "#97C3A1" },
          "punctuation": { "color": "#F2F3E8" },
          "punctuation.bracket": { "color": "#CFD2CD" },
          "punctuation.delimiter": { "color": "#CFD2CD" },
          "string": { "color": "#F78B93" },
          "string.escape": { "color": "#68C5DB" },
          "string.regex": { "color": "#FD7649" },
          "tag": { "color": "#FCB057" },
          "text.literal": { "color": "#F2F3E8" },
          "title": { "color": "#F7EA9A", "font_weight": 700 },
          "type": { "color": "#B1E7B8" },
          "variable": { "color": "#97C3A1" },
          "variable.special": { "color": "#83BCFF" },
          "variant": { "color": "#B39EE6" }
        }
      }
    }
  ]
}
