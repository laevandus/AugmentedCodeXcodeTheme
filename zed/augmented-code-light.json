{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Augmented Code",
  "author": "Toomas",
  "themes": [
    {
      "name": "Augmented Code Light",
      "appearance": "light",
      "style": {
        "accents": ["#D16B08", "#387845", "#1A6BB8", "#7354AD", "#1A6E85"],
        "background": "#F2EBDD",
        "border": "#CFC1A7",
        "border.focused": "#1A6E85",
        "border.selected": "#D16B08",
        "border.variant": "#DDD2BC",
        "conflict": "#D16B08",
        "created": "#387845",
        "deleted": "#C72E38",
        "editor.active_line.background": "#EFE7D5",
        "editor.active_line_number": "#423B2E",
        "editor.background": "#F6F0E0",
        "editor.foreground": "#423B2E",
        "editor.gutter.background": "#F6F0E0",
        "editor.indent_guide": "#E4DAC3",
        "editor.indent_guide_active": "#CFC1A7",
        "editor.invisible": "#DBD1B8",
        "editor.line_number": "#8C826E",
        "editor.wrap_guide": "#E4DAC3",
        "element.active": "#CFC1A7",
        "element.background": "#EBE2CE",
        "element.hover": "#E2D7C0",
        "element.selected": "#CFC1A7",
        "error": "#C72E38",
        "error.background": "#F2D9D3",
        "ghost_element.hover": "#EBE2CE",
        "icon": "#716858",
        "icon.accent": "#1A6E85",
        "icon.muted": "#8C826E",
        "info": "#1A6BB8",
        "link_text.hover": "#1A6E85",
        "modified": "#D16B08",
        "pane.focused_border": "#1A6E85",
        "panel.background": "#F2EBDD",
        "panel.indent_guide": "#E4DAC3",
        "players": [{ "cursor": "#423B2E", "selection": "#DBD1B8", "background": "#F6F0E0" }],
        "scrollbar.thumb.background": "#CFC1A7",
        "scrollbar.thumb.hover_background": "#B9AA8F",
        "search.match_background": "#E4C586",
        "status_bar.background": "#F2EBDD",
        "success": "#387845",
        "surface.background": "#EBE2CE",
        "tab.active_background": "#F6F0E0",
        "tab.inactive_background": "#F2EBDD",
        "tab_bar.background": "#E8DFC9",
        "terminal.background": "#F6F0E0",
        "terminal.foreground": "#423B2E",
        "terminal.bright_foreground": "#312A23",
        "terminal.dim_foreground": "#716858",
        "terminal.ansi.black": "#E8DFC9",
        "terminal.ansi.red": "#C72E38",
        "terminal.ansi.green": "#387845",
        "terminal.ansi.yellow": "#D16B08",
        "terminal.ansi.blue": "#1A6BB8",
        "terminal.ansi.magenta": "#7354AD",
        "terminal.ansi.cyan": "#1A6E85",
        "terminal.ansi.white": "#746D5E",
        "terminal.ansi.bright_black": "#B9AA8F",
        "terminal.ansi.bright_red": "#C72E0A",
        "terminal.ansi.bright_green": "#388040",
        "terminal.ansi.bright_yellow": "#CC8C0D",
        "terminal.ansi.bright_blue": "#0D61D1",
        "terminal.ansi.bright_magenta": "#7354AD",
        "terminal.ansi.bright_cyan": "#1A7385",
        "terminal.ansi.bright_white": "#312A23",
        "text": "#423B2E",
        "text.accent": "#1A6E85",
        "text.disabled": "#8C826E",
        "text.muted": "#716858",
        "warning": "#D16B08",
        "syntax": {
          "attribute": { "color": "#854F24" },
          "boolean": { "color": "#7354AD" },
          "comment": { "color": "#8C826E", "font_style": "italic" },
          "comment.doc": { "color": "#8C826E", "font_style": "italic" },
          "constant": { "color": "#387845" },
          "constructor": { "color": "#387845" },
          "embedded": { "color": "#C72E38" },
          "emphasis": { "color": "#423B2E", "font_style": "italic" },
          "enum": { "color": "#7354AD" },
          "function": { "color": "#387845" },
          "hint": { "color": "#8C826E" },
          "keyword": { "color": "#D16B08", "font_weight": 700 },
          "label": { "color": "#D16B08" },
          "link_text": { "color": "#1A6E85" },
          "number": { "color": "#7354AD" },
          "operator": { "color": "#D16B08" },
          "predictive": { "color": "#8C826E" },
          "property": { "color": "#387845" },
          "punctuation": { "color": "#423B2E" },
          "punctuation.bracket": { "color": "#8C826E" },
          "punctuation.delimiter": { "color": "#8C826E" },
          "string": { "color": "#C72E38" },
          "string.escape": { "color": "#1A6E85" },
          "string.regex": { "color": "#C72E0A" },
          "tag": { "color": "#D16B08" },
          "text.literal": { "color": "#423B2E" },
          "title": { "color": "#B89414", "font_weight": 700 },
          "type": { "color": "#388040" },
          "variable": { "color": "#387845" },
          "variable.special": { "color": "#1A6BB8" },
          "variant": { "color": "#7354AD" }
        }
      }
    }
  ]
}
